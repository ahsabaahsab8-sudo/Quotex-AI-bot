# ==============================================================================
# Quotex AI Bot — Environment Configuration Blueprint
# ==============================================================================
# Copy this file to .env and configure your credentials.

QUOTEX_EMAIL=your_quotex_email@example.com
QUOTEX_PASSWORD=your_quotex_password
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Vision & Reasoning LLM Keys ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── NVIDIA API Gateway ───────────────────────────────────────────────────────
NVIDIA_NEMOTRON_API_KEY=your_nvidia_nemotron_key_here
NVIDIA_LLAMA_API_KEY=your_nvidia_llama_key_here

# ─── Kilo Code Vision Model Keys ──────────────────────────────────────────────
KILO_NEMOTRON_NANO_API_KEY=your_kilo_nemotron_key_here
KILO_DOTS_NOTE_API_KEY=your_kilo_dots_key_here
KILO_NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
KILO_DOTS_NOTE_MODEL=dots-studio/dots-3-note-preview:free
KILO_NEMOTRON_NANO_MAX_TOKENS=1024
KILO_DOTS_NOTE_MAX_TOKENS=1024

# ─── Proxy & Networking ───────────────────────────────────────────────────────
CAMOUFOX_USE_PROXY=false
BOT_USE_PROXY=false
TELEGRAM_PROXY=

# ─── Email & OTP Authentication ───────────────────────────────────────────────
IMAP_EMAIL=your_email@gmail.com
IMAP_PASSWORD=your_imap_app_password
